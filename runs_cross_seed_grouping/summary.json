  "quantities": "Delta[s,g] = PPL(FC,s,g) - PPL(FR,s,g) for s in {0,1,2}, g in 5 grouping seeds (all 15, none excluded); m_s = mean_g Delta[s,g]; sd_s = SD_g (ddof 1); se_s = sd_s/sqrt(5); W = pooled within-seed SD = sqrt(mean_s sd_s^2); M = mean_s m_s; SB = SD_s(m_s) (ddof 1); EXP = W/sqrt(5)",
  "RUN-BLOCKED": "any of the 30 configurations missing or invalid, a cache / determinism / reuse-integrity check fails, or the seed-0 reused results do not match their frozen artifacts",
  "ALLOCATION-SEED-DEPENDENT": "(a) conflicting confident directions: some m_s > 2 se_s AND some m_t < -2 se_t; OR (b) material scale disagreement: SB >= 2 EXP (seed means spread at least twice what grouping averaging alone predicts) AND max_s |m_s| >= W",
  "GROUPING-VARIATION-DOMINATES": "(checked after seed dependence) |M| < 0.5 W AND at least 1/3 of the 15 Delta[s,g] have sign opposite to sign(M)",
  "FC-PPL-PENALTY-ROBUST": "all m_s > 0 AND in every seed >= 3/5 groupings FC worse AND M >= 0.5 W",
  "FC-PPL-ADVANTAGE-EXPLORATORY": "all m_s < 0 AND in every seed >= 3/5 groupings FC better AND -M >= 0.5 W",
  "fallback": "otherwise GROUPING-VARIATION-DOMINATES with ambiguous=True (explicitly reported)",
  "precedence": "RUN-BLOCKED > ALLOCATION-SEED-DEPENDENT > GROUPING-VARIATION-DOMINATES > FC-PPL-PENALTY-ROBUST / FC-PPL-ADVANTAGE-EXPLORATORY > fallback"
