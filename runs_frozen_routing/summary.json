 "decision": "ROUTING-AND-ACTIVATION-INTERACT",
 "decision_rule": {
  "metrics_per_strategy": {
   "h_C": "median over the 16 prespecified diagnostic Hessians (layers 1/8/16/23 x experts 0/30 x gu/down) of the trace-normalized relative Frobenius difference ||H_C/tr H_C - H_OO/tr H_OO||_F / ||H_OO/tr H_OO||_F",
   "w_C": "relative L2 difference of all 720 effective weight tensors of condition C from OO",
   "dY_C": "PPL(C) - PPL(OO); contrasts A_R0 = Y_AO - Y_OO, R_X0 = Y_OA - Y_OO, I = Y_AA - Y_AO - Y_OA + Y_OO",
   "TAU": "0.000924 = 1e-4 x BF16 PPL (deterministic tolerance of the grouping studies); |x| < TAU is treated as 0"
  },
  "flags_per_strategy": {
   "local_suppression": "h_AO <= 0.5 h_AA AND w_AO <= 0.5 w_AA",
   "local_routing_dominant": "h_OA >= h_AO AND w_OA >= w_AO",
   "ppl_suppression": "|dY_AA| > TAU AND |dY_AO| <= 0.5 |dY_AA|",
   "activation_dominant": "h_AO > h_OA AND w_AO > w_OA AND |dY_AO| > |dY_OA| (with |dY_AO| > TAU)",
   "interaction_large": "|I| > TAU AND |I| >= 0.5 max(|A_R0|, |R_X0|)"
  },
  "ranking_preserved": "|Delta_AO - Delta_OO| <= 0.5 |Delta_AA - Delta_OO|, Delta_C = PPL_FC(C) - PPL_FR(C)",
  "precedence": [
   "RUN-BLOCKED: a natural-condition regression (routing, Hessians, weights, reconstruction) fails, a hybrid configuration is missing / invalid, or forced routing was active during evaluation",
   "FROZEN-ROUTING-SUPPRESSES-SENSITIVITY: local_suppression AND ppl_suppression in BOTH strategies AND ranking_preserved AND NOT interaction_large in either strategy",
   "ACTIVATION-VALUES-DOMINATE: activation_dominant in BOTH strategies",
   "LOCAL-ROUTING-EFFECT-WITHOUT-PPL-EXPLANATION: (local_suppression OR local_routing_dominant) in BOTH strategies, AND (ppl_suppression fails in at least one strategy OR NOT ranking_preserved)",
   "ROUTING-AND-ACTIVATION-INTERACT: otherwise (neither factor alone explains the natural effect, or the interaction is large); the interaction flags are always reported"
  ],
  "frozen": "fixed before any hybrid (AO / OA) quantization or PPL; never adjusted after outcomes"
 },
