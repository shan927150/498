 "decision_rule": {
  "quantities": "over the 5 new groupings g only: Delta_g = PPL(FC,g) - PPL(FR,g); Delta_O = +0.010057 (frozen partial-PPL ORIGINAL); I_g = Delta_g - Delta_O; Range_s = max_g PPL(s,g) - min_g PPL(s,g); SD = sample SD (ddof=1) of Delta_g; tau = 1e-4 x PPL_BF16 (the established deterministic PPL tolerance of the earlier protocols; NOT re-derived from strategy effects); reversal_g = sign(Delta_g) != sign(Delta_O) AND |Delta_g| > tau",
  "precedence": "INVALID-COMPARISON > RUN-BLOCKED > GROUPING-DEPENDENT-RANKING > RANKING-STABLE-BUT-SENSITIVE > RANKING-ROBUST-WITHIN-TESTED-GROUPINGS",
  "INVALID-COMPARISON": "any grouping differs from ORIGINAL in token ids, layer kwargs (positions / mask / rotary), model weights, dtype, attention implementation or eval mode, or a configuration fails its installation checks (240 experts, 720 projections changed, no RTN fallback, untouched parameters unchanged, finite weights)",
  "RUN-BLOCKED": "a configuration is missing, or a determinism control fails (ORIGINAL FR/FC not reproduced bitwise, repeated PPL evaluation differs, reversed execution order changes the activations)",
  "GROUPING-DEPENDENT-RANKING": "any reversal_g, OR max_g |I_g| >= 0.5 |Delta_O|, OR SD >= 0.5 |Delta_O|",
  "RANKING-STABLE-BUT-SENSITIVE": "no reversal and both comparability conditions fail, but max_g |I_g| > max(tau, 0.1 |Delta_O|) or max_s Range_s > max(tau, 0.1 |Delta_O|)",
  "RANKING-ROBUST-WITHIN-TESTED-GROUPINGS": "otherwise (direction preserved in 5/5; I and Range within max(tau, 0.1 |Delta_O|))"
 },
