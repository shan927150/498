 "decision_rule": {
  "quantities": "r_s = (E_test(FR,s) - E_test(SC,s)) / E_test(FR,s), E = mean held-out relative reconstruction over the 240-expert test universe, ORIGINAL extraction; r_conf_s same on the confirmation split; r_L = 3-seed mean relative improvement in layer L; mean r = mean_s r_s",
  "SUPPORTED": "r_s > 0 for all 3 seeds AND r_L > 0 for >= 3 of 4 layers AND mean r >= 0.5 % AND mean r_conf > 0",
  "ROBUST-SUPPORTED": "SUPPORTED AND, under the paired grouping design (Stage B), the grouping-averaged reconstruction advantage is > 0 in every allocation seed AND its hierarchical-bootstrap 95 % interval (seeds, then groupings) excludes zero",
  "NO-GAIN": "mean r < 0.5 % (no material improvement on the primary test split)",
  "INCONCLUSIVE": "mean r >= 0.5 % but a SUPPORTED condition fails (seed, layer or confirmation direction), OR SUPPORTED but the grouping-averaged advantage is <= 0 in some allocation seed",
  "precedence": "NO-GAIN is checked first; then ROBUST-SUPPORTED > SUPPORTED > INCONCLUSIVE",
  "scope": "primary comparison SC vs FR; the same rule is applied, descriptively labelled, to SC vs TR and SC vs TC",
  "ppl": "PPL is reported descriptively; no PPL claim if the grouping SD of paired PPL differences is >= |mean|"
